APP_ENV=development
PORT=8080
APP_BASE_URL=http://localhost:8080
DATABASE_URL=postgres://usuario:clave@localhost:5432/bd_spa?sslmode=disable
JWT_SECRET=reemplazar-por-un-secreto-aleatorio-de-al-menos-32-bytes
JWT_ISSUER=spa-api
JWT_AUDIENCE=spa-web
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
DB_MAX_OPEN_CONNS=20
MAX_UPLOAD_MB=10
UPLOAD_DIR=.dev-uploads
CLIENT_APP_DIR=ClientApp
AI_PROVIDER=local
AI_TIMEOUT_SECONDS=30
